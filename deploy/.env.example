# Reference only. Normally deploy/.env is GENERATED with random passwords:
#
#   docker run --rm -v "${PWD}:/work" -w /work alpine:3.22 sh make-env.sh
#
# Running make-env.sh again on an existing .env only adds missing settings.
# If you write .env by hand instead: replace every value, use letters and
# digits only (a '$' is misread by Docker Compose and Grafana), and never
# commit the file.

POSTGRES_USER=ofm_admin
POSTGRES_PASSWORD=ReplaceMe1
OFM_RUNTIME_DB_PASSWORD=ReplaceMe2
OFM_CONFIG_DB_PASSWORD=ReplaceMe3
OFM_READER_DB_PASSWORD=ReplaceMe4
OFM_MATHESAR_DB_PASSWORD=ReplaceMe10
OFM_MQTT_RUNTIME_PASSWORD=ReplaceMe5
OFM_MQTT_READER_PASSWORD=ReplaceMe6
NODERED_ADMIN_USER=admin
NODERED_ADMIN_PASSWORD=ReplaceMe7
NODE_RED_CREDENTIAL_SECRET=ReplaceMe8
GRAFANA_USER=admin
GRAFANA_PASSWORD=ReplaceMe9
MATHESAR_ADMIN_USER=admin
MATHESAR_ADMIN_PASSWORD=ReplaceMe11
MATHESAR_DB_PASSWORD=ReplaceMe12
MATHESAR_SECRET_KEY=ReplaceWithAtLeast50RandomLettersAndDigits
# Optional services: 'simulator' runs the OPC UA simulator (leave empty at a plant)
COMPOSE_PROFILES=simulator
