# Normalise line endings in Git; keep Linux line endings for files that run or
# are read inside containers (a Windows CRLF line ending breaks shell scripts).
* text=auto
*.sh text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
deploy/mosquitto/config/acl text eol=lf
*.sql text eol=lf
